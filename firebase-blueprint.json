{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "Stores user profile information and subscription status.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier for the user." },
        "name": { "type": "string", "description": "Display name of the user." },
        "email": { "type": "string", "format": "email", "description": "Email address of the user." },
        "photoUrl": { "type": "string", "description": "URL to the user's profile photo." },
        "isPremium": { "type": "boolean", "description": "Whether the user has a premium subscription." },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "User role for access control." },
        "provider": { "type": "string", "enum": ["google", "telegram", "email"], "description": "Authentication provider." },
        "telegramId": { "type": "string", "description": "Telegram user ID." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user account was created." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "When the user account was last updated." }
      },
      "required": ["uid", "name"]
    },
    "subscriptions": {
      "title": "Subscription",
      "description": "Stores user subscription details.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "ID of the user who owns the subscription." },
        "status": { "type": "string", "enum": ["active", "expired", "canceled"], "description": "Current status of the subscription." },
        "planId": { "type": "string", "description": "ID of the subscription plan." },
        "expiresAt": { "type": "string", "format": "date-time", "description": "When the subscription expires." }
      },
      "required": ["userId", "status", "planId"]
    },
    "telegramusers": {
      "title": "Telegram User Details",
      "description": "Stores detailed information about Telegram users.",
      "type": "object",
      "properties": {
        "id": { "type": "number", "description": "Telegram user ID." },
        "firstName": { "type": "string", "description": "Telegram user first name." },
        "lastName": { "type": "string", "description": "Telegram user last name." },
        "username": { "type": "string", "description": "Telegram username." },
        "languageCode": { "type": "string", "description": "Telegram user language code." },
        "isPremium": { "type": "boolean", "description": "Whether the user has Telegram Premium." },
        "addedToAttachmentMenu": { "type": "boolean", "description": "Whether the user added the bot to the attachment menu." },
        "allowsWriteToPm": { "type": "boolean", "description": "Whether the user allows the bot to write to PM." },
        "photoUrl": { "type": "string", "description": "URL to the user's profile photo." },
        "lastSeen": { "type": "string", "format": "date-time", "description": "When the user was last seen in the app." }
      },
      "required": ["id", "firstName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profile documents."
    },
    "/subscriptions/{subscriptionId}": {
      "schema": "subscriptions",
      "description": "User subscription documents."
    },
    "/telegramusers/{userId}": {
      "schema": "telegramusers",
      "description": "Detailed Telegram user information."
    }
  }
}
